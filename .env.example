# Environment variables for Synapse SDK and blockchain
# Replace with your actual values

# Blockchain configuration
PROVIDED_URL=https://api.calibration.node.glif.io/rpc/v1
NEXT_PUBLIC_PRIVATE_KEY=your_private_key_here_without_quotes

# For Synapse SDK
SYNAPSE_PRIVATE_KEY=your_private_key_here_without_quotes
SYNAPSE_RPC_URL=https://api.calibration.node.glif.io/rpc/v1

# Note: 
# - Remove the "0x" prefix if it's already included
# - Use calibration testnet for testing
# - Never commit real private keys to version control
